#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        studio_unlock: studio_unlock { compatible = "zmk,behavior-studio-unlock"; };
    };

    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <500>;
            key-positions = <17 18>;
            bindings = <&studio_unlock>;
        };
    };

    macros {
        PTR_RIGHT: PTR_RIGHT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "PTR_RIGHT";
        };

        PTR_LEFT: PTR_LEFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp MINUS>;
            label = "PTR_LEFT";
        };

        TRIPLE_QUOTE: TRIPLE_QUOTE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp DOUBLE_QUOTES>;
            label = "TRIPLE_QUOTE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 2  &kp SPACE    &kp RET  &mo 1  &kp RALT
            >;
        };

        Nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans       &kp N6    &kp N7        &kp N8    &kp N9               &kp N0         &kp BSPC
&bt BT_SEL 2  &bt BT_SEL 3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans       &kp HOME  &kp LC(LEFT)  &kp UP    &kp LC(RIGHT_ARROW)  &kp PAGE_UP    &caps_word
&bt BT_SEL 4  &kp NUMBER_0  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans       &kp END   &kp LEFT      &kp DOWN  &kp RIGHT            &kp PAGE_DOWN  &bt BT_CLR
                                          &kp LGUI      &trans        &kp SPACE    &kp RET   &trans        &kp RALT
            >;
        };

        Symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE    &TRIPLE_QUOTE    &kp COLON     &kp HASH           &kp DLLR  &kp PRCNT         &kp CARET             &kp AMPS               &PTR_LEFT      &PTR_RIGHT        &kp TILDE  &kp BSPC
&kp AT_SIGN  &kp EXCLAMATION  &kp QUESTION  &kp DOUBLE_QUOTES  &kp SQT   &kp UNDERSCORE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LBKT       &kp RBKT          &kp BSLH   &trans
&trans       &kp SLASH        &kp ASTERISK  &kp EQUAL          &kp PLUS  &kp MINUS         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN  &kp PIPE   &trans
                                            &kp LGUI           &trans    &kp SPACE         &kp RET               &trans                 &kp RALT
            >;
        };
    };
};
